<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>InstallerUiTests.Entry</StartupObject><EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PayloadFixture.cs" />
    <Compile Include="../../installer/InstallerMain*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../installer/InstallerPrerequisites.cs" Link="InstallerPrerequisites.cs" />
    <Compile Include="../../installer/PayloadArchive.cs" Link="PayloadArchive.cs" />
    <Compile Include="../../installer/InstallerWindow*.cs" Link="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../installer/ModernInstaller.xaml" LogicalName="installer-ui.xaml" />
    <Resource Include="../../src/SpankyhoOptimizer/Assets/AppLogo.png" Link="AppLogo.png" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="ZstdSharp.Port" Version="0.8.8" /></ItemGroup>
</Project>
