<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Spankyho_Optimizer_V$(SpankyVersionUnderscore)_Setup</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>cs;en-US</SatelliteResourceLanguages>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AssemblyTitle>Glass Optimizer Setup</AssemblyTitle>
    <Product>Glass Optimizer</Product>
    <Company>Spankyho</Company>
    <Nullable>enable</Nullable>
    <SpankyInstallerPayloadPath Condition="'$(SpankyInstallerPayloadPath)' == ''">payload.tar.zst</SpankyInstallerPayloadPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ModernInstaller.cs" />
    <Page Remove="ModernInstaller.xaml" />
    <EmbeddedResource Include="ModernInstaller.xaml" LogicalName="installer-ui.xaml" />
    <EmbeddedResource Include="$(SpankyInstallerPayloadPath)" LogicalName="payload.tar.zst" />
    <Content Include="App.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\src\SpankyhoOptimizer\Assets\AppLogo.png" Link="AppLogo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>


