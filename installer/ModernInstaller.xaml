<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#12121F">
  <Grid Width="930" Height="603" ClipToBounds="True">
    <Image Source="/ReferenceInstaller.png"
           Width="930" Height="603"
           Stretch="Fill"
           SnapsToDevicePixels="True"/>

    <Canvas Width="930" Height="603">
      <Border x:Name="DragArea"
              Canvas.Left="8" Canvas.Top="8"
              Width="880" Height="43"
              Background="#01000000"/>

      <Button x:Name="CloseButton"
              Canvas.Left="886" Canvas.Top="9"
              Width="36" Height="34"
              Background="Transparent"
              BorderThickness="0"
              Opacity="0.01"
              Cursor="Hand"/>

      <Button x:Name="BackButton"
              Canvas.Left="568" Canvas.Top="548"
              Width="108" Height="40"
              IsEnabled="False"
              Background="Transparent"
              BorderThickness="0"
              Opacity="0.01"/>

      <Button x:Name="InstallButton"
              Canvas.Left="685" Canvas.Top="547"
              Width="116" Height="42"
              Background="Transparent"
              BorderThickness="0"
              Opacity="0.01"
              Cursor="Hand"/>

      <Button x:Name="CancelButton"
              Canvas.Left="809" Canvas.Top="547"
              Width="116" Height="42"
              Background="Transparent"
              BorderThickness="0"
              Opacity="0.01"
              Cursor="Hand"/>

      <TextBlock x:Name="ProcessorValue"
                 Canvas.Left="69" Canvas.Top="267"
                 Width="220" Foreground="#F3EFF8"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="12.5" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>

      <TextBlock x:Name="GraphicsValue"
                 Canvas.Left="69" Canvas.Top="335"
                 Width="220" Foreground="#F3EFF8"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="12.5" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>

      <TextBlock x:Name="MemoryValue"
                 Canvas.Left="69" Canvas.Top="389"
                 Width="220" Foreground="#F3EFF8"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="12.5" FontWeight="SemiBold"/>

      <TextBlock x:Name="MotherboardValue"
                 Canvas.Left="69" Canvas.Top="440"
                 Width="220" Foreground="#F3EFF8"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="12.5" FontWeight="SemiBold"
                 TextWrapping="Wrap"/>

      <TextBlock x:Name="SecureBootValue"
                 Canvas.Left="69" Canvas.Top="504"
                 Width="220" Foreground="#F3EFF8"
                 FontFamily="Segoe UI Variable Text"
                 FontSize="12.5" FontWeight="SemiBold"/>

      <StackPanel x:Name="ProgressArea"
                  Canvas.Left="505" Canvas.Top="488"
                  Width="390"
                  Visibility="Collapsed">
        <Border Background="#E6161227"
                BorderBrush="#7355C8"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,8">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="PhaseText"
                         Text="PŘIPRAVENO"
                         Foreground="#BBA5FF"
                         FontSize="9"
                         FontWeight="SemiBold"/>
              <TextBlock x:Name="StatusText"
                         Text=""
                         Foreground="#C8C0D8"
                         FontSize="9"
                         HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="InstallProgress"
                         Minimum="0" Maximum="100"
                         Height="5"
                         Margin="0,7,0,0"
                         Background="#2B243A"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Canvas>

    <Grid Visibility="Collapsed">
      <TextBox x:Name="InstallPath"/>
      <CheckBox x:Name="DesktopShortcut"/>
      <CheckBox x:Name="LaunchAfter"/>
      <Button x:Name="BrowseButton"/>

      <Border x:Name="DotNetCard">
        <StackPanel>
          <Border x:Name="DotNetDot"/>
          <TextBlock x:Name="DotNetState"/>
        </StackPanel>
      </Border>
      <Border x:Name="WinAppCard">
        <StackPanel>
          <Border x:Name="WinAppDot"/>
          <TextBlock x:Name="WinAppState"/>
        </StackPanel>
      </Border>

      <StackPanel>
        <Border x:Name="StepInstall"><TextBlock x:Name="StepInstallText"/></Border>
        <Border x:Name="StepComponents"><TextBlock x:Name="StepComponentsText"/></Border>
        <Border x:Name="StepDone"><TextBlock x:Name="StepDoneText"/></Border>
      </StackPanel>

      <TextBox x:Name="LiveLog"/>
      <StackPanel x:Name="FinalActions">
        <Button x:Name="RunButton"/>
        <Button x:Name="OpenFolderButton"/>
        <Button x:Name="FinishCloseButton"/>
      </StackPanel>
      <TextBlock x:Name="FooterHint" Text=""/>
    </Grid>
  </Grid>
</Border>
