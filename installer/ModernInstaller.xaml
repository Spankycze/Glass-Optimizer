<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        CornerRadius="23" BorderThickness="0" BorderBrush="Transparent"
        Background="#770B1729" SnapsToDevicePixels="True">
  <Border.Resources>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFAFDFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#F0E7F7FF"/>
    <SolidColorBrush x:Key="GlassLow" Color="#D0152B45"/>
    <SolidColorBrush x:Key="GlassEdge" Color="#7C4276A8"/>
    <SolidColorBrush x:Key="AccentGlass" Color="#F5068DFE"/>
    <SolidColorBrush x:Key="AccentEdge" Color="#62507AA6"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF"/>
    <Style x:Key="GlassButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Background" Value="{StaticResource GlassLow}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15,6"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="18" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#50078DEF"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#5C477DA7"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#9A087AD9"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#86519BCB"/>
                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.46"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionIconButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
      <Setter Property="Background" Value="#01000000"/>
      <Setter Property="BorderBrush" Value="#00000000"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="BrowseLinkButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
      <Setter Property="Background" Value="#01000000"/>
      <Setter Property="BorderBrush" Value="#00000000"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#3EA8FF"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
      <Setter Property="Background" Value="#01000000"/>
      <Setter Property="BorderBrush" Value="#00000000"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#A9C4DC"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Padding" Value="14,3"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
      <Setter Property="Background" Value="{StaticResource AccentGlass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentEdge}"/>
      <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="26,8"/>
    </Style>
    <Style x:Key="GlassCheck" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="#01000000" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Content" VerticalAlignment="Center"
                                HorizontalAlignment="Left" RecognizesAccessKey="True"/>
              <Border x:Name="CheckPlate" Grid.Column="1" Width="42" Height="23" CornerRadius="11.5"
                      Background="#48102742" BorderBrush="#483B6D95" BorderThickness="1"
                      Padding="3,0">
                <Grid>
                  <Ellipse x:Name="ToggleThumb" Width="15" Height="15" Fill="#C8DDF0"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                  <Path x:Name="CheckGlyph" Data="M 3,8 L 7,12 L 15,4"
                        Stroke="#FFFFFFFF" StrokeThickness="2.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Stretch="Uniform" Width="10" Height="10" Visibility="Collapsed" Opacity="0"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckPlate" Property="Background" Value="#F20892FF"/>
                <Setter TargetName="CheckPlate" Property="BorderBrush" Value="#7056AED0"/>
                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="ToggleThumb" Property="Fill" Value="#FFFFFFFF"/>
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CheckPlate" Property="BorderBrush" Value="#5D468DBB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CheckPlate" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GlassTextBox" TargetType="TextBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Background" Value="#010D2945"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="CaretBrush" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#513B6D95"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
      <!-- Keep WPF native text/caret/scroll layout; overriding PART_ContentHost
           manually clipped path text on an off-screen WPF renderer. -->
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#5A467FA8"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="#81569CC8"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="GlassExpander" TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="ExpanderToggle" HorizontalAlignment="Left"
                            Background="#280A77D4" BorderBrush="#4A3C7399" BorderThickness="1"
                            Cursor="Hand" Padding="9,5" Foreground="#F3FBFF"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ExpanderPlate" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ExpanderPlate" Property="Background" Value="#4B087AD8"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ExpanderPlate" Property="Background" Value="#440B78D1"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="ExpanderChevron" Data="M 2,5 L 8,11 L 14,5"
                        Stroke="#F0FAFF" StrokeThickness="2" Width="14" Height="14"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ExpanderChevron" Property="Data" Value="M 2,11 L 8,5 L 14,11"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Border.Resources>
  <!-- Dark matte-glass surface: readable against any desktop wallpaper,
       while retaining rounded layered HWND corners and blue accents. -->
  <Grid Width="712" Height="486" ClipToBounds="True" SnapsToDevicePixels="True">
    <Grid.Clip>
      <RectangleGeometry Rect="0,0,712,486" RadiusX="24" RadiusY="24"/>
    </Grid.Clip>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7812223A" Offset="0"/>
        <GradientStop Color="#74101D31" Offset="0.55"/>
        <GradientStop Color="#78081628" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid x:Name="InstallerContent" Margin="17">
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="144"/>
        <RowDefinition Height="0"/>
        <RowDefinition Height="156"/>
        <RowDefinition Height="84"/>
        <RowDefinition Height="34"/>
      </Grid.RowDefinitions>

      <!-- One frosted material sheet replaces four flat feature boxes. -->
      <Border x:Name="SingleGlassSurface" Grid.Row="0" Grid.RowSpan="6"
              Margin="-17" CornerRadius="23" BorderThickness="0"
              BorderBrush="#003D78AB" Background="#480E243F"
              IsHitTestVisible="False">
        <Ellipse Width="390" Height="185" HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,-24,0,0" IsHitTestVisible="False">
          <Ellipse.Fill>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.35" RadiusX="0.5" RadiusY="0.5">
              <GradientStop Color="#4C1589FF" Offset="0"/>
              <GradientStop Color="#200C55A8" Offset="0.54"/>
              <GradientStop Color="#000E243F" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Border>

      <!-- Minimal SideKick-style caption bar with subtle title on left and clean icon controls on right. -->
      <Grid x:Name="DragArea" Background="#01000000" Panel.ZIndex="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Glass Optimizer Setup" FontSize="12" FontWeight="SemiBold"
                   Margin="6,0,0,0" VerticalAlignment="Center"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   Foreground="#B8D4EC"/>
        <Button x:Name="MinimizeButton" Grid.Column="1" Width="32" Height="28"
                Margin="0,0,4,0" VerticalAlignment="Center"
                Style="{StaticResource CaptionIconButton}" AutomationProperties.Name="Minimalizovat instalátor">
          <Path Data="M 4,11 L 16,11" Stroke="#DCEEFF" StrokeThickness="1.8"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="14" Height="14" Stretch="Uniform"/>
        </Button>
        <Button x:Name="CloseButton" Grid.Column="2" Width="32" Height="28"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionIconButton}" AutomationProperties.Name="Zavřít instalátor">
          <Path Data="M 4,4 L 16,16 M 16,4 L 4,16" Stroke="#DCEEFF"
                StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="13" Height="13" Stretch="Uniform"/>
        </Button>
      </Grid>

      <!-- Centered hero with glowing app icon badge, bold welcome heading, and subtitle. -->
      <Border x:Name="InstallCard" Grid.Row="1" Margin="16,4,16,0"
              Background="#00000000" BorderBrush="#00000000"
              BorderThickness="0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="68" Height="68" CornerRadius="17" HorizontalAlignment="Center"
                  Background="#D608182C" BorderBrush="#483E7BB0" BorderThickness="1">
            <Image Source="/AppLogo.png" Width="48" Height="48" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="InstallHeading" Text="Připraveno k instalaci"
                     FontSize="25" FontWeight="Bold" Margin="0,12,0,0"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     FontFamily="Segoe UI Variable Display, Segoe UI"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource TextPrimary}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <TextBlock x:Name="InstallDescription"
                       Text="Bezpečná aktualizace · tvoje nastavení zůstanou."
                       FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="#A8C4DE"/>
            <Border Width="0" Height="0" Opacity="0" Margin="0" Padding="0" BorderThickness="0">
              <TextBlock x:Name="InstallBadge" Text="PŘIPRAVENO"
                         FontSize="10.5" Foreground="#EFFCFF" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- SideKick-style clean centered settings rows separated by subtle 1px dividers. -->
      <StackPanel x:Name="ReadySection" Grid.Row="3" Width="468"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Height="1" Background="#264577A6"/>
        <Grid Height="52">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="Umístění aplikace" FontSize="11"
                       Foreground="#8CA8C3"/>
            <TextBox x:Name="InstallPath" Height="22" VerticalContentAlignment="Center"
                     Margin="-2,1,0,0" Background="#01081B31" BorderBrush="#303B6D95"
                     Style="{StaticResource GlassTextBox}"
                     AutomationProperties.Name="Cílová složka instalace"/>
          </StackPanel>
          <Button x:Name="BrowseButton" Grid.Column="1" Content="Změnit"
                  VerticalAlignment="Center"
                  Style="{StaticResource BrowseLinkButton}"/>
        </Grid>
        <Border Height="1" Background="#264577A6"/>
        <Grid Height="44">
          <CheckBox x:Name="DesktopShortcut" Content="Zástupce na ploše"
                    Style="{StaticResource GlassCheck}"/>
        </Grid>
        <Border Height="1" Background="#264577A6"/>
        <Grid Height="44">
          <CheckBox x:Name="LaunchAfter" Content="Spustit po instalaci"
                    Style="{StaticResource GlassCheck}"/>
        </Grid>
        <Border Height="1" Background="#264577A6"/>
      </StackPanel>

      <!-- Full-canvas borderless SideKick-style progress stage with centered icon, large percentage readout, and sleek bar.
           The numeric percent is the last confirmed installer report, not a fake timer. -->
      <Border x:Name="EfficiencyCard" Grid.Row="0" Grid.RowSpan="6" Margin="-17"
              CornerRadius="23" Background="#C8081526"
              BorderBrush="#004875A5" BorderThickness="0" Padding="24,14"
              Opacity="0" IsHitTestVisible="False" Panel.ZIndex="1">
        <Grid>
          <Ellipse Width="390" Height="200" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,12,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#441589FF" Offset="0"/>
                <GradientStop Color="#1C0C55A8" Offset="0.55"/>
                <GradientStop Color="#00081526" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <StackPanel x:Name="ProgressArea" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="0,6,0,0">
            <Border x:Name="ProgressLogoBadge" Width="72" Height="72" CornerRadius="18"
                    HorizontalAlignment="Center" Background="#DF09172A"
                    BorderBrush="#423E7BB0" BorderThickness="1">
              <Image Source="/AppLogo.png" Width="50" Height="50" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ProgressPercent" Text="0 %"
                       FontSize="46" FontWeight="Bold" MinWidth="110" Margin="0,16,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       Foreground="#FFFAFDFF"/>
            <ProgressBar x:Name="InstallProgress" Minimum="0" Maximum="100" Value="0"
                         Width="372" Height="21" Margin="0,10,0,0"
                         AutomationProperties.Name="Průběh instalace">
              <ProgressBar.Template>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                  <Grid Background="#0008192D" SnapsToDevicePixels="True">
                    <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                            Background="#382B4E73" SnapsToDevicePixels="True"/>
                    <Border x:Name="PART_Track" Height="6" VerticalAlignment="Center"
                            Background="Transparent"/>
                    <Border x:Name="PART_Indicator" Height="6" VerticalAlignment="Center"
                            CornerRadius="3" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                          <GradientStop Color="#FF1477E5" Offset="0"/>
                          <GradientStop Color="#FF13B7FB" Offset="0.65"/>
                          <GradientStop Color="#FF6AE5FF" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                  </Grid>
                </ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
            <TextBlock x:Name="StatusText" Text="Instalace zatím nebyla spuštěna."
                       FontSize="12.5" Margin="0,8,0,0" MaxWidth="420"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#A8C4DE"/>
            <TextBlock x:Name="PhaseText" Text="PŘIPRAVENO" FontSize="10.5"
                       FontWeight="Bold" Height="0" Opacity="0" Margin="0"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="#FF70D4FF"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Centered primary pill button and subtle secondary Cancel action below it. -->
      <Grid Grid.Row="4" Panel.ZIndex="2">
        <StackPanel x:Name="ReadyActions" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button x:Name="BackButton" Content="Zpět" Visibility="Collapsed"
                  Style="{StaticResource GlassButton}"/>
          <Button x:Name="InstallButton" Content="Nainstalovat" Width="212" Height="40"
                  HorizontalAlignment="Center" Style="{StaticResource AccentButton}"/>
          <Button x:Name="CancelButton" Content="Zrušit" Width="112" Height="26"
                  Margin="0,7,0,0" HorizontalAlignment="Center"
                  Style="{StaticResource SubtleButton}"/>
          <StackPanel x:Name="FinalActions" Orientation="Horizontal" HorizontalAlignment="Center"
                      Visibility="Collapsed">
            <Button x:Name="RunButton" Content="Spustit" Width="112" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}"/>
            <Button x:Name="OpenFolderButton" Content="Složka" Width="94" Margin="0,0,8,0"
                    Style="{StaticResource GlassButton}"/>
            <Button x:Name="FinishCloseButton" Content="Hotovo" Width="94"
                    Style="{StaticResource GlassButton}"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Centered subtle footer caption. -->
      <Grid Grid.Row="5" Panel.ZIndex="3">
        <TextBlock x:Name="FooterHint" Text="Ověřený balíček  ·  bez ztráty nastavení"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                   FontSize="11" Foreground="{StaticResource TextSecondary}"/>
      </Grid>
    </Grid>

    <!-- Matching compact frosted error sheet: only its details scroll on demand. -->
    <Grid x:Name="ErrorOverlay" Visibility="Collapsed" Background="#AA020B30"
          Panel.ZIndex="40" KeyboardNavigation.TabNavigation="Cycle">
      <Border x:Name="ErrorCard" Width="552" MaxHeight="406" CornerRadius="21"
              BorderThickness="1" BorderBrush="#5758789C"
              Background="#EE0B367B" Padding="19,17"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorHeading" FontSize="19" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,9,0"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
            <Button x:Name="ErrorClose" Grid.Column="1" Width="34" Height="34"
                    Padding="0" Style="{StaticResource GlassButton}"
                    AutomationProperties.Name="Zavřít chybu">
              <Path Data="M 4,4 L 16,16 M 16,4 L 4,16" Stroke="#F0FAFF"
                    StrokeThickness="2.15" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"/>
            </Button>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,13,0,0">
            <TextBlock x:Name="ErrorGuidance" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="ErrorSummary" FontSize="12" TextWrapping="Wrap"
                       MaxHeight="55" Margin="0,9,0,0" Foreground="#FFF1F8FF"/>
            <Expander x:Name="ErrorMore" Header="Technické podrobnosti" FontSize="11"
                      Style="{StaticResource GlassExpander}"
                      Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0">
              <TextBox x:Name="ErrorDetails" IsReadOnly="True"
                       Style="{StaticResource GlassTextBox}" TextWrapping="Wrap"
                       Height="95" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       AutomationProperties.Name="Technické podrobnosti chyby"/>
            </Expander>
          </StackPanel>
          <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="ErrorLog" Content="Otevřít protokol" HorizontalAlignment="Left"
                    Style="{StaticResource GlassButton}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="ErrorDismiss" Content="Zpět" Width="80" Margin="0,0,7,0"
                      Style="{StaticResource GlassButton}"/>
              <Button x:Name="ErrorRetry" Content="Zkusit znovu" Width="119"
                      Style="{StaticResource AccentButton}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Compatibility anchors for existing transactional installer logic. -->
    <Grid Visibility="Collapsed">
      <Border x:Name="DotNetCard"><StackPanel><Border x:Name="DotNetDot"/><TextBlock x:Name="DotNetState"/></StackPanel></Border>
      <Border x:Name="WinAppCard"><StackPanel><Border x:Name="WinAppDot"/><TextBlock x:Name="WinAppState"/></StackPanel></Border>
      <StackPanel>
        <Border x:Name="StepInstall"><TextBlock x:Name="StepInstallText"/></Border>
        <Border x:Name="StepComponents"><TextBlock x:Name="StepComponentsText"/></Border>
        <Border x:Name="StepDone"><TextBlock x:Name="StepDoneText"/></Border>
      </StackPanel>
      <TextBox x:Name="LiveLog"/>
    </Grid>
  </Grid>
</Border>
