<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)'=='SpankyhoOptimizer' Or '$(MSBuildProjectName)'=='SpankyhoOptimizer.Core' Or '$(MSBuildProjectName)'=='SpankyhoOptimizer.RuntimeHost' Or '$(MSBuildProjectName)'=='SpankyInstaller'">
    <SpankyVersion>15.4.603</SpankyVersion>
    <SpankyVersionUnderscore>$([System.String]::Copy('$(SpankyVersion)').Replace('.', '_'))</SpankyVersionUnderscore>
    <Version>$(SpankyVersion)</Version>
    <AssemblyVersion>$(SpankyVersion).0</AssemblyVersion>
    <FileVersion>$(SpankyVersion).0</FileVersion>
    <InformationalVersion>$(SpankyVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)'=='SpankyhoOptimizer' Or '$(MSBuildProjectName)'=='SpankyhoOptimizer.Core'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel Condition="'$(Configuration)'=='Release'">latest-recommended</AnalysisLevel>
    <ReportAnalyzer Condition="'$(ExtendedAnalyzerAudit)'=='true'">true</ReportAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="('$(ExtendedAnalyzerAudit)'=='true' Or '$(AnalyzerMeziantou)'=='true' Or '$(AnalyzerThreading)'=='true' Or '$(AnalyzerAsyncFixer)'=='true' Or '$(AnalyzerPhilips)'=='true') And ('$(MSBuildProjectName)'=='SpankyhoOptimizer' Or '$(MSBuildProjectName)'=='SpankyhoOptimizer.Core')">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers.audit.globalconfig" />
  </ItemGroup>
</Project>
